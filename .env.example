# ---- BimpeAI (required) -------------------------------------------------
# Team API key from the BimpeAI Developer Console. Keys are prefixed `sk_`.
BIMPE_API_KEY=sk_replace_me
# Optional override; defaults to https://api.bimpe.ai
BIMPE_BASE_URL=https://api.bimpe.ai

# ---- KrosAI (optional fallback) ----------------------------------------
# Only used if you switch the voice provider to `kros`. Keys look like `kros_live_...`
KROS_API_KEY=
KROS_BASE_URL=https://api.krosai.com/api/v1

# ---- Server -------------------------------------------------------------
PORT=8787
# Public URL of this server. Needed for callbacks/webhooks in real deployments.
PUBLIC_BASE_URL=http://localhost:8787

# ---- Interview behaviour ------------------------------------------------
# Hard cap on call length for the demo (seconds).
INTERVIEW_MAX_SECONDS=300
# Score (0-100) at or above which a candidate is considered qualified.
INTERVIEW_PASS_THRESHOLD=70
# After a call ends, how long to wait for the platform to publish the transcript
# (seconds). Set 0 to disable the grace window.
INTERVIEW_TRANSCRIPT_GRACE_SECONDS=45
# How long to let the destination ring before treating the call as no-answer and
# releasing the single-call guard (seconds). Set 0 to wait out INTERVIEW_MAX_SECONDS.
INTERVIEW_RING_TIMEOUT_SECONDS=75
# Voice provider: `bimpe` (default) or `kros` (fallback).
VOICE_PROVIDER=bimpe

# ---- Provisioning -------------------------------------------------------
# Names used when creating the platform agents (must be stable across restarts).
INTERVIEWER_AGENT_NAME=Interview Copilot
EVALUATOR_AGENT_NAME=Interview Evaluator
# The WhatsApp hiring assistant: it receives post-interview summaries and answers
# the owner's questions about candidates.
ASSISTANT_AGENT_NAME=Hiring Assistant

# Phone-number provisioning request (used only if no number is linked yet).
PHONE_BUSINESS_NAME=AgentScrut Demo
PHONE_INTENDED_USE=Outbound candidate screening interviews
PHONE_REGION=ng
PHONE_OUTBOUND_MINUTES=120

# ---- Hiring assistant (WhatsApp) ---------------------------------------
# The owner's WhatsApp number (E.164) that receives a short summary after every
# interview and can message the assistant with questions. Leave empty to disable
# outbound summaries.
OWNER_WHATSAPP=+2349023349937
# Use the agent's BimpeAI *test* WhatsApp channel (default). The test channel
# only responds once the owner has texted first: send "start <CODE>" to the
# test number (shown in the status panel), then summaries and answers flow.
# Set to false for a connected production WhatsApp Business channel.
WHATSAPP_TEST_CHANNEL=true
